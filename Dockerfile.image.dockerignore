# Scoped dockerignore for `Dockerfile.image`. Buildx prefers
# `<dockerfile>.dockerignore` when one exists alongside `--file`, so this
# deployment-specific list stays independent from the root Docker context.

.git
.idea
.cursor
.github
.circleci
.r2g
node_modules
dist
lib
docs
test
fixtures
**/*.log
.dockerignore
Dockerfile
Dockerfile.r2g
**/.DS_Store
